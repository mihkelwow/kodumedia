# KoduMedia 0.8.56 — Windows x64
# Ära ava porti 8096 internetti. Serveril puudub veel autentimine.
MEDIA_SERVER_ADDRESS=0.0.0.0:8096

# Kataloog, seaded, metadata vahemälu, subtiitrid ja ajutised transkodeeringud.
MEDIA_SERVER_DATA_DIR=.\data

# KoduMedia väljalase sisaldab tools\ffmpeg\bin kaustas FFmpeg/FFprobe binaare
# ning valib need automaatselt. Täida need ainult enda kontrollitud build'i jaoks.
MEDIA_SERVER_FFMPEG=
MEDIA_SERVER_FFPROBE=

# Valikuline kohandatud yt-dlp tee. Kui see on tühi ja yt-dlp pole PATH-is,
# laadib KoduMedia Windowsis fikseeritud ametliku binaari esimesel vajadusel
# data\tools\yt-dlp kausta ning kontrollib selle SHA-256 summat.
MEDIA_SERVER_YTDLP=

# TMDb API Read Access Token (Bearer token, mitte lühike v3 API key).
# Sama väärtust saab hiljem brauseris turvaliselt lisada või muuta.
TMDB_TOKEN=
MEDIA_SERVER_METADATA_LANGUAGE=en-US

# IMDb reitingute ametlik HTTPS allikas. Server hoiab failist kohalikku cache'i.
IMDB_RATINGS_SOURCE=https://datasets.imdbws.com/title.ratings.tsv.gz

# Shazami audio-tuvastus on esimene automaatne vaste ning ei vaja API võtit.
# Kasutusel on mitteametlik pöördprojekteeritud endpoint: see on tasuta, kuid
# võib tulevikus muutuda või ajutiselt päringuid piirata. Sellisel juhul jätkab
# KoduMedia AcoustID/MusicBrainzi, kataloogivaste ja lokaalse analüüsiga.
MUSIC_METADATA_ENABLED=true
MUSIC_SHAZAM_ENABLED=true
MUSIC_FINGERPRINT_ENABLED=true
MUSIC_CATALOG_FALLBACK_ENABLED=true
MUSIC_AUDIO_ANALYSIS_ENABLED=true
MUSIC_GENERATED_ARTWORK_ENABLED=true
ACOUSTID_API_KEY=

# Eelistatud subtiitrikeeled, tähtsuse järjekorras.
MEDIA_SERVER_SUBTITLE_LANGUAGES=en

# Valikuline OpenSubtitles.com integratsioon. Soovitus: seadista brauseris,
# kus salvestatud saladusi API kaudu tagasi ei väljastata.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Transkodeerimissessiooni eemaldamise aeg pärast viimast kasutust.
MEDIA_SERVER_TRANSCODE_IDLE_TTL=2m

# Vajalik ainult eraldi origin'iga arenduskliendile.
MEDIA_SERVER_ALLOWED_ORIGINS=
