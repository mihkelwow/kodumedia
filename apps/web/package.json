{
  "name": "@kodumedia/web",
  "private": true,
  "version": "0.8.57",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:registry": "node ./scripts/verify-public-registry.mjs",
    "check:i18n": "node ./scripts/verify-i18n.mjs",
    "prebuild": "npm run check",
    "pretypecheck": "npm run check",
    "pretest": "npm run check",
    "check:ui": "node ./scripts/verify-ui-foundation.mjs",
    "check": "npm run check:registry && npm run check:i18n && npm run check:ui"
  },
  "dependencies": {
    "embla-carousel-react": "^8.6.0",
    "hls.js": "^1.6.16",
    "react": "^19.2.7",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10.8.2"
  },
  "packageManager": "npm@10.9.2"
}
